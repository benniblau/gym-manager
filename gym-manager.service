[Unit]
Description=Gym Manager Flask Application
After=network.target

[Service]
Type=notify
# Change this to your user
User=www-data
Group=www-data

# Change this to your application directory
WorkingDirectory=/var/www/gym-manager

# Change this to your virtual environment path
Environment="PATH=/var/www/gym-manager/venv/bin"

# Load environment variables from .env file
EnvironmentFile=/var/www/gym-manager/.env

# Gunicorn command
ExecStart=/var/www/gym-manager/venv/bin/gunicorn --config gunicorn_config.py wsgi:app

# Restart policy
Restart=always
RestartSec=10

# Performance and security
PrivateTmp=true
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gym-manager

[Install]
WantedBy=multi-user.target
