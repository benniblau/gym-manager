# Flask Configuration
# CRITICAL: Generate a strong secret key for production!
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Strava API Credentials
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Strava OAuth Redirect URI
# Update this to match your deployment URL
# For local development: http://localhost:5001/strava/callback
# For production: https://yourdomain.com/strava/callback
STRAVA_REDIRECT_URI=http://localhost:5001/strava/callback

# Note: STRAVA_ACCESS_TOKEN and STRAVA_REFRESH_TOKEN are per-user
# and stored in the database, not in this file

# Production Server Configuration (Gunicorn)
# Port for the application to listen on
PORT=8000

# Number of Gunicorn worker processes
# Default: (CPU cores * 2) + 1
# Adjust based on your server resources
GUNICORN_WORKERS=4

# Log level (debug, info, warning, error, critical)
LOG_LEVEL=info

# MCP Server Configuration
# Transport mode: 'http' for standalone server, 'stdio' for subprocess (Claude Desktop)
GM_MCP_TRANSPORT=http

# Bind host and port for HTTP transport
GM_MCP_HTTP_HOST=0.0.0.0
GM_MCP_HTTP_PORT=8085

# Path to the SQLite database (defaults to ./exercises.db relative to project root)
# DATABASE_PATH=/opt/gym-manager/exercises.db

# Internal URL of the MCP server — Flask proxies /mcp here.
# This should be the localhost address of the MCP server process.
# The MCP server does NOT need to be publicly exposed.
GM_MCP_URL=http://127.0.0.1:8085
